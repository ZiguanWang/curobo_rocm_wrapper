+      best_x.data_ptr<scalar_t>(), best_c.data_ptr<scalar_t>(),
+      best_grad.data_ptr<scalar_t>(), g_x.data_ptr<scalar_t>(),
+      x_set.data_ptr<scalar_t>(), step_vec.data_ptr<scalar_t>(),
