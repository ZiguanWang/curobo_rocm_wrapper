+    assert torch.version.hip and torch.cuda.is_available()
+    from curobo.curobolib import kinematics_fused_cu
+
+    rotation = torch.eye(3, device="cuda").reshape(1, 3, 3).contiguous()
+    output = torch.empty((1, 4), device="cuda")
+    result = kinematics_fused_cu.matrix_to_quaternion(output, rotation)[0]
