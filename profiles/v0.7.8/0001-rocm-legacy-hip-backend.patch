+"""Run the legacy sphere/OBB HIP kernel."""
+
+import torch
+
+
+def test_sphere_obb_on_hip() -> None:
+    assert torch.version.hip and torch.cuda.is_available()
+    from curobo.curobolib import geom_cu
+
+    sphere = torch.tensor([[[[0.7, 0.0, 0.0, 0.1]]]], device="cuda")
+    distance = torch.zeros((1, 1, 1), device="cuda")
+    gradient = torch.zeros((1, 1, 1, 4), device="cuda")
+    sparse = torch.zeros((1, 1, 1), device="cuda", dtype=torch.uint8)
+    identity = torch.eye(4, device="cuda").reshape(1, 4, 4)
+    result = geom_cu.closest_point(
+        sphere, distance, gradient, sparse, torch.tensor([1.0], device="cuda"),
+        torch.tensor([0.15], device="cuda"), torch.tensor([10.0], device="cuda"),
