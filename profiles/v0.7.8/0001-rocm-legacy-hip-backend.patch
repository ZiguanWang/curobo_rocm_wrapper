+          u_position[b_idx * horizon * dof + (h_idx - 3) * dof + d_idx],
+          u_position[b_idx * horizon * dof + (h_idx - 2) * dof + d_idx],
+          u_position[b_idx * horizon * dof + (h_idx - 1) * dof + d_idx]);
