+      out_grad = (g_pos +
+                  (g_vel[0] -  g_vel[1]) * dt +
+                  (g_acc[0] - 2 * g_acc[1] + g_acc[2]) * dt * dt +
+                  (g_jerk[0] - 3 * g_jerk[1] + 3 * g_jerk[2] - g_jerk[3]) * dt * dt * dt);
