+        grad = torch.full_like(q, 2.0)
+        result = lbfgs_step_cu.forward(
+            step, rho, y, s, q, grad, torch.zeros_like(q), torch.ones_like(q),
+            0.1, batch, history, dimension, True, shared,
+        )[0]
+        torch.cuda.synchronize()
+        assert torch.isfinite(result).all()
+        results.append(result.clone())
+    assert torch.allclose(results[0], results[1], atol=1e-5)
+
+    best_cost = torch.full((batch, 1), 10.0, device="cuda")
+    best_q = torch.zeros((batch, dimension), device="cuda")
+    best_iteration = torch.zeros((batch,), device="cuda", dtype=torch.int16)
+    current_iteration = torch.zeros((batch,), device="cuda", dtype=torch.int16)
+    cost = torch.tensor([[2.0], [3.0]], device="cuda")
+    candidate = torch.arange(batch * dimension, device="cuda", dtype=torch.float32).reshape(batch, dimension)
+    updated = line_search_cu.update_best(
+        best_cost, best_q, best_iteration, current_iteration, cost, candidate,
+        dimension, batch, 1, 4, 1e-5, 0.999,
+    )
+    torch.cuda.synchronize()
+    assert torch.allclose(updated[0], cost)
+    assert torch.allclose(updated[1], candidate)
