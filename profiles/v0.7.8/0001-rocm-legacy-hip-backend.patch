+"""Run the legacy acceleration trajectory HIP kernel."""
+
+import torch
+
+
+def test_acceleration_step_on_hip() -> None:
+    assert torch.version.hip and torch.cuda.is_available()
+    from curobo.curobolib import tensor_step_cu
+
+    batch, horizon, dof = 1, 8, 4
+    outputs = [torch.empty((batch, horizon, dof), device="cuda") for _ in range(4)]
+    controls = torch.zeros((batch, horizon, dof), device="cuda")
+    starts = [torch.zeros((batch, dof), device="cuda") for _ in range(3)]
+    result = tensor_step_cu.step_acceleration(
+        *outputs, controls, *starts, torch.full((horizon,), 0.1, device="cuda"), batch, horizon, dof, True
+    )
+    torch.cuda.synchronize()
+    assert all(torch.isfinite(value).all() and torch.count_nonzero(value) == 0 for value in result)
