+      reduce_v1<scalar_t, psum_t>(y * y, v_dim, &data[0], &result);
+      scalar_t denominator = result;
+
+      // reduce(s*y, v_dim, data, &result); // redundant - already computed it above
+      // scalar_t numerator = result;
