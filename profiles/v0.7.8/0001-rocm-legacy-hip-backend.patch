+      if (tid >= batch_size * dof * horizon)
+      {
+        return;
+      }
+      const int b_addrs        = b_idx * horizon * dof;
+      const int b_addrs_action = b_idx * (horizon - 4) * dof;
+
+      if ((h_idx < 2) || (h_idx >= horizon - 2))
+      {
+        return;
+      }
