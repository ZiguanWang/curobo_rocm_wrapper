+
+          // // int leader = __ffs(mask2) – 1;    // select a leader lane
+          if (threadIdx.x % 32 == leader)
+          {
+            result[0] = (scalar_t)val2;
+          }
+        }
+      }
+      else
+      {
+        if (threadIdx.x == leader)
+        {
+          result[0] = (scalar_t)val;
+        }
+      }
+      __syncthreads();
