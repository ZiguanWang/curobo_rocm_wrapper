+# Copyright (c) 2026 cuRobo ROCm wrapper contributors
+# Licensed under the NVIDIA License shipped with cuRobo v0.7.8.
+"""Fail-closed ROCm runtime and legacy extension preflight for cuRobo v0.7.8."""
+
+from __future__ import annotations
+
+import importlib
+import os
+
+import torch
+
+EXTENSIONS = (
+    "curobo.curobolib.lbfgs_step_cu",
+    "curobo.curobolib.kinematics_fused_cu",
+    "curobo.curobolib.line_search_cu",
+    "curobo.curobolib.tensor_step_cu",
+    "curobo.curobolib.geom_cu",
+)
+
+
+def validate() -> dict[str, object]:
+    """Validate ROCm, the requested architecture, and all legacy extensions."""
+    if torch.version.hip is None or not torch.cuda.is_available():
+        raise RuntimeError("cuRobo v0.7.8 ROCm profile requires an available ROCm GPU")
+    architecture = os.environ.get("PYTORCH_ROCM_ARCH")
+    if not architecture:
+        raise RuntimeError("PYTORCH_ROCM_ARCH must identify the target gfx architecture")
+    for module_name in EXTENSIONS:
+        importlib.import_module(module_name)
+    return {
+        "torch": torch.__version__,
+        "rocm": torch.version.hip,
+        "device": torch.cuda.get_device_name(0),
+        "architecture": architecture,
+        "extensions": list(EXTENSIONS),
+    }
+
+
+def main() -> None:
+    """Print the validated legacy ROCm runtime."""
+    print(validate())
+
+
+if __name__ == "__main__":
+    main()
