+def torch_matrix_to_quaternion(matrix: torch.Tensor) -> torch.Tensor:
+    """Convert rotation matrices to real-first quaternions using PyTorch operations.
+
+    Args:
+        matrix: Rotation matrices with shape ``(..., 3, 3)``.
+
+    Returns:
+        Real-first quaternions with shape ``(..., 4)``.
+    """
+    if matrix.shape[-2:] != (3, 3):
+        raise ValueError(f"Expected rotation matrices with shape (..., 3, 3), got {matrix.shape}")
+
+    m00 = matrix[..., 0, 0]
+    m01 = matrix[..., 0, 1]
+    m02 = matrix[..., 0, 2]
+    m10 = matrix[..., 1, 0]
+    m11 = matrix[..., 1, 1]
+    m12 = matrix[..., 1, 2]
+    m20 = matrix[..., 2, 0]
+    m21 = matrix[..., 2, 1]
+    m22 = matrix[..., 2, 2]
+
+    candidates = torch.stack(
+        (
+            1.0 + m00 + m11 + m22,
+            1.0 + m00 - m11 - m22,
+            1.0 - m00 + m11 - m22,
+            1.0 - m00 - m11 + m22,
+        ),
+        dim=-1,
+    ).clamp_min(0.0)
+    quaternion_abs = torch.sqrt(candidates)
+    quaternion_candidates = torch.stack(
+        (
+            torch.stack(
+                (quaternion_abs[..., 0].square(), m21 - m12, m02 - m20, m10 - m01), dim=-1
+            ),
+            torch.stack(
+                (m21 - m12, quaternion_abs[..., 1].square(), m01 + m10, m02 + m20), dim=-1
+            ),
+            torch.stack(
+                (m02 - m20, m01 + m10, quaternion_abs[..., 2].square(), m12 + m21), dim=-1
+            ),
+            torch.stack(
+                (m10 - m01, m02 + m20, m12 + m21, quaternion_abs[..., 3].square()), dim=-1
+            ),
+        ),
+        dim=-2,
+    )
+    denominator = (2.0 * quaternion_abs).clamp_min(torch.finfo(matrix.dtype).eps)
+    quaternion_candidates = quaternion_candidates / denominator.unsqueeze(-1)
+    best_candidate = quaternion_abs.argmax(dim=-1)
+    gather_index = best_candidate[..., None, None].expand(best_candidate.shape + (1, 4))
+    return torch.gather(quaternion_candidates, -2, gather_index).squeeze(-2)
