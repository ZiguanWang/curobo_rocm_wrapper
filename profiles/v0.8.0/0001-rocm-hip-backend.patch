@@ -13,7 +13,90 @@ creating any cuRobo objects:
    runtime.torch_compile = True  # enable torch.compile
 """
 
+from dataclasses import dataclass
+from enum import Enum
 from pathlib import Path
+from typing import Any, Optional
+
+
+class AcceleratorType(str, Enum):
+    """Accelerator implementation used by the installed PyTorch build."""
+
+    CPU = "cpu"
+    CUDA = "cuda"
+    ROCM = "rocm"
+
+
+@dataclass(frozen=True)
+class AcceleratorCapabilities:
+    """Describe accelerator features used to select cuRobo implementations."""
+
+    #: Active accelerator runtime.
+    accelerator: AcceleratorType
+    #: Whether the runtime can execute cuRobo custom kernels.
+    supports_custom_kernels: bool
+    #: Whether graph capture has passed validation and is enabled.
+    supports_graph_capture: bool
+    #: Whether NVIDIA cuda.core can be used.
+    supports_cuda_core: bool
+
+
+def detect_accelerator(torch_module: Optional[Any] = None) -> AcceleratorType:
+    """Detect the accelerator supplied by the installed PyTorch build.
+
+    Args:
+        torch_module: Optional torch-compatible module used by isolated tests.
+
+    Returns:
+        Accelerator type for the installed PyTorch build and visible hardware.
+    """
+    if torch_module is None:
+        import torch as torch_module
+
+    torch_version = getattr(torch_module, "version", None)
+    if getattr(torch_version, "hip", None) is not None:
+        return AcceleratorType.ROCM
+    if getattr(torch_version, "cuda", None) is not None:
+        return AcceleratorType.CUDA
+    return AcceleratorType.CPU
+
+
+def get_accelerator_capabilities(
+    torch_module: Optional[Any] = None,
+) -> AcceleratorCapabilities:
+    """Return coarse capabilities for the installed accelerator runtime.
+
+    Args:
+        torch_module: Optional torch-compatible module used by isolated tests.
+
+    Returns:
+        Accelerator capabilities used during backend selection and bring-up.
+    """
+    accelerator = detect_accelerator(torch_module)
+    has_gpu_runtime = accelerator in (AcceleratorType.CUDA, AcceleratorType.ROCM)
+    return AcceleratorCapabilities(
+        accelerator=accelerator,
+        supports_custom_kernels=has_gpu_runtime,
+        supports_graph_capture=(
+            accelerator == AcceleratorType.CUDA
+            or (accelerator == AcceleratorType.ROCM and rocm_graphs)
+        ),
+        supports_cuda_core=accelerator == AcceleratorType.CUDA,
+    )
+
+
+def is_graph_capture_enabled(torch_module: Optional[Any] = None) -> bool:
+    """Return whether graph capture is enabled for the active accelerator.
+
+    Args:
+        torch_module: Optional torch-compatible module used by isolated tests.
+
+    Returns:
+        ``True`` when global graph execution and the accelerator implementation are enabled.
+    """
+    if not cuda_graphs:
+        return False
+    return get_accelerator_capabilities(torch_module).supports_graph_capture
 
