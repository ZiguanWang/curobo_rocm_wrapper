+def _normalize_revolute_seed_config(
+    seed_config: torch.Tensor,
+    current_state: JointState,
+    kinematics: Kinematics,
+) -> torch.Tensor:
+    """Map revolute IK seeds to the equivalent configuration nearest the start.
+
+    IK can return solutions separated from the current state by one or more full
+    revolutions.  They have the same forward kinematics, but interpolating to the
+    raw values creates unnecessary multi-turn trajectories that can collide.
+    Prismatic joints and normalized values outside the configured position limits
+    are left unchanged.
+    """
+    config = kinematics.kinematics_config
+    joint_map = config.joint_map.long()
+    joint_types = config.joint_map_type.long()
+    revolute_types = torch.tensor(
+        [
+            JointType.X_ROT.value,
+            JointType.Y_ROT.value,
+            JointType.Z_ROT.value,
+            JointType.X_ROT_NEG.value,
+            JointType.Y_ROT_NEG.value,
+            JointType.Z_ROT_NEG.value,
+        ],
+        device=joint_types.device,
+        dtype=joint_types.dtype,
+    )
+    valid_links = joint_map >= 0
+    revolute_links = valid_links & torch.isin(joint_types, revolute_types)
+    revolute_mask = torch.zeros(
+        config.num_dof,
+        device=seed_config.device,
+        dtype=torch.bool,
+    )
+    revolute_mask[joint_map[revolute_links]] = True
+
+    start_position = current_state.position.unsqueeze(-2)
+    delta = seed_config - start_position
+    nearest = start_position + torch.atan2(torch.sin(delta), torch.cos(delta))
+    position_limits = config.joint_limits.position.to(seed_config.device)
+    within_limits = (nearest >= position_limits[0]) & (nearest <= position_limits[1])
+    use_nearest = revolute_mask.view(*([1] * (seed_config.ndim - 1)), -1) & within_limits
+    return torch.where(use_nearest, nearest, seed_config)
+
+
+def _replace_failed_seed_config(
+    seed_config: torch.Tensor,
+    success: torch.Tensor,
+) -> torch.Tensor:
+    """Replace failed IK seeds with the first successful seed.
+
+    Chained boolean indexing returns a temporary tensor, so assigning through
+    ``seed_config[~success][:]`` does not update the seed pool passed to TrajOpt.
+    """
+    first_success = seed_config[success][0]
+    return torch.where(success.unsqueeze(-1), seed_config, first_success)
+
+
+def _make_local_ik_seed_config(
+    current_state: JointState,
+    kinematics: Kinematics,
+    num_seeds: int,
+    attempt: int,
+    noise_scale: float = 0.35,
+) -> torch.Tensor:
+    """Create deterministic IK seeds around the current joint configuration."""
+    generator = torch.Generator(device="cpu")
+    generator.manual_seed(0)
+    seed_shape = (current_state.position.shape[0], num_seeds, current_state.position.shape[-1])
+    noise = torch.randn(
+        (seed_shape[0], (attempt + 1) * num_seeds, seed_shape[2]),
+        generator=generator,
+        device="cpu",
+        dtype=torch.float32,
+    )[:, -num_seeds:].to(
+        device=current_state.position.device,
+        dtype=current_state.position.dtype,
+    )
+    seeds = current_state.position.unsqueeze(1) + noise_scale * noise
+    position_limits = kinematics.kinematics_config.joint_limits.position.to(
+        device=seeds.device,
+        dtype=seeds.dtype,
+    )
+    return torch.clamp(
+        seeds,
+        min=position_limits[0].view(1, 1, -1),
+        max=position_limits[1].view(1, 1, -1),
+    )
+
+
+def _make_collision_escape_ik_seed_config(
+    center: torch.Tensor,
+    kinematics: Kinematics,
+    num_seeds: int,
+    attempt: int,
+    noise_scale: float = 0.01,
