+    """Perturb a nearly feasible IK solution to escape a shallow collision."""
+    generator = torch.Generator(device="cpu")
+    generator.manual_seed(1000)
+    noise = torch.randn(
+        (center.shape[0], (attempt + 1) * num_seeds, center.shape[-1]),
+        generator=generator,
+        device="cpu",
+        dtype=torch.float32,
+    )[:, -num_seeds:].to(device=center.device, dtype=center.dtype)
+    seeds = center[:, :1].expand(-1, num_seeds, -1) + noise_scale * noise
